<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" 
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" 
        name="ekv" 
        uuid="A1B2C3D4-E5F6-7890-1234-56789ABCDEF0">
    
    <target name="ekv">
        <root class="EKVDB" feature="make"/>
        <option warning="warning">
            <!-- Включаем проверку всех контрактов (require, ensure, invariant) -->
            <assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true"/>
        </option>
        
        <setting name="console_application" value="true"/>
        <setting name="total_order_on_reals" value="false"/>
        <!-- Отключаем SCOOP, чтобы убрать зависимость от base-scoop-safe прекомпилята -->
        
        <!-- Подключаем базовую библиотеку через $ISE_LIBRARY -->
        <library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
        
        <!-- Исходный код наших классов с Linux-путем -->
        <cluster name="src" location="./src/" recursive="true"/>
    </target>
</system>